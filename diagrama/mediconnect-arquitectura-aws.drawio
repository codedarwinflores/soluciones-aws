1" parent="1"><mxGeometry x="495" y="700" width="465" height="265" as="geometry"/></mxCell><mxCell id="c42" value="Subnet privada datos B · 10.0.21.0/24 · sin ruta a Internet" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=30;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="1010" y="700" width="465" height="265" as="geometry"/></mxCell><mxCell id="c50" value="Servicios administrados regionales" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#879196;dashed=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1555" y="120" width="455" height="515" as="geometry"/></mxCell><mxCell id="c60" value="Seguridad, monitoreo y costos" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#879196;dashed=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1555" y="655" width="455" height="300" as="geometry"/></mxCell><mxCell id="c69" value="Región us-west-2 (recuperación ante desastres)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=30;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="1555" y="975" width="455" height="200" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;MediConnect — Arquitectura AWS de la plataforma de telemedicina&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#232F3E;spacing=6;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Región principal us-east-1 (N. Virginia) · 2 zonas de disponibilidad · DR de archivos y backups en us-west-2" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#232F3E;spacing=6;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Escalado:&lt;/b&gt; ECS Service Auto Scaling con Target Tracking (CPU 60 % y solicitudes por tarea en el ALB) + &lt;b&gt;Scheduled Scaling&lt;/b&gt; que pre-calienta la capacidad los lunes a las 6:00 a.m. (10x).&lt;br&gt;&lt;b&gt;Security Groups encadenados:&lt;/b&gt; CloudFront (prefix list) → ALB :443 → tareas :3000/:8000 → RDS :3306 / ElastiCache :6379.&lt;br&gt;&lt;b&gt;Base de datos sin acceso público&lt;/b&gt; (PubliclyAccessible = false, subnets sin ruta a Internet). Credenciales en &lt;b&gt;Secrets Manager&lt;/b&gt; con rotación automática, inyectadas como variables de entorno en la definición de tarea de ECS.&lt;br&gt;&lt;b&gt;Durabilidad:&lt;/b&gt; backups automáticos de RDS (30 días, PITR) + copias a us-west-2 con AWS Backup; S3 con versionado, Object Lock y replicación entre regiones." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;spacing=6;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="455" y="1015" width="1060" height="105" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;Flujos:&lt;/b&gt; 1 Resolución DNS · 2 Usuario → CloudFront (TLS, WAF, Shield) · 3 CloudFront → ALB · 4 El ALB enruta por host a Next.js o a la API · 5 Next.js → API por la red interna (ECS Service Connect) · 6 API → RDS MySQL · 7 API → ElastiCache · 8 Archivos médicos con URLs prefirmadas a través del Gateway Endpoint de S3 · 9 Notificaciones asíncronas: API → SQS → workers → SES / SMS · 10 Reportes desacoplados: EventBridge → tarea Fargate → réplica de lectura → S3 · 11 Video: la API crea la reunión en Chime SDK y el media viaja por WebRTC directo con los usuarios · 12 Replicación de archivos a us-west-2. Las subnets privadas de aplicación salen a Internet solo por los NAT Gateway (uno por AZ); las de datos no tienen salida." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fillColor=#F7F7F7;strokeColor=#879196;fontColor=#232F3E;spacing=6;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="1205" width="1990" height="72" as="geometry"/></mxCell><mxCell id="c72" value="1 DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#147EBA;fontSize=10;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="348"/><mxPoint x="140" y="186"/></Array></mxGeometry></mxCell><mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#147EBA;fontSize=10;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="578"/><mxPoint x="140" y="186"/></Array></mxGeometry></mxCell><mxCell id="c74" value="2 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#14